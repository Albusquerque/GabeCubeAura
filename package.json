{
  "name": "signalbar",
  "version": "0.7.1",
  "description": "Smart status lighting for Steam Machine",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "rollup -c -w",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "PYTHONPYCACHEPREFIX=/tmp/signalbar-pycache PYTHONPATH=py_modules python3 -m unittest discover -s tests/backend -v",
    "test:frontend": "tsx --test tests/frontend/*.test.ts",
    "package": "python3 scripts/package_plugin.py"
  },
  "keywords": [
    "decky",
    "steam-machine",
    "steamos",
    "led",
    "status"
  ],
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "tsx": "^4.20.5",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
